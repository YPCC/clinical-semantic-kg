        <mxCell id="14" value="Agent Orchestrator&#xa;[Container]&#xa;Google ADK + LangGraph&#xa;Intent / Tool Selector&#xa;Workflow Runtime + CLI" style="rounded=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1a202c;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1120" y="130" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="15" value="Extraction Workers&#xa;[Container]&#xa;Classical NLP channel&#xa;Multi-agent extractors&#xa;Coreference / Reconcile" style="rounded=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a202c;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="900" y="260" width="180" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="16" value="RDF Pipeline&#xa;[Container]&#xa;Grounding (OAKlib)&#xa;Triple gen + SHACL&#xa;Trusted KG store" style="rounded=1;fontSize=11;fillColor=#b2f5ea;strokeColor=#319795;fontColor=#1a202c;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1120" y="260" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="17" value="HITL Service&#xa;[Container]&#xa;Argilla integration&#xa;Review queues and&#xa;feedback loop" style="rounded=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a202c;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="900" y="390" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="18" value="Query and App API&#xa;[Container]&#xa;SPARQL / GraphQL&#xa;GraphRAG endpoints&#xa;CDS hooks" style="rounded=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a202c;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1120" y="390" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="19" value="C4 Legend&#xa;• Context: people and external systems that interact with the platform&#xa;• Container: major deployable / runnable units inside the platform&#xa;• All containers are orchestrated via ADK CLI + Workflow Runtime&#xa;• 3rd-party tools (spaCy, OntoGPT...) are called as CLI tools from Extraction Workers" style="rounded=1;fontSize=11;align=left;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1a202c;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="900" y="520" width="500" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="20" value="ARCHITECTURE DECISION HIGHLIGHT&#xa;&#xa;CLI-first tool wrapping (OntoGPT CLI, spaCy pipelines,&#xa;pySHACL CLI, etc.) is preferred over heavy in-process&#xa;libraries so that agents spend fewer tokens, have&#xa;deterministic control, and can version / sandbox each tool." style="rounded=1;fontSize=12;align=left;fillColor=#b2f5ea;strokeColor=#319795;fontColor=#1a202c;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="400" height="120" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
